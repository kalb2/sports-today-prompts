{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sports-today-prompts",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1, "invocation_logs": false },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	// Local `wrangler dev` / Vitest use Miniflare (isolated local KV). No preview_id.
	"kv_namespaces": [
		{
			"binding": "FEED",
			"id": "d3d54619d3df4701ba64ddb7bd98bc4f"
		}
	],
	"d1_databases": [
		{
			"binding": "VOTES",
			"database_name": "ball-knowledge-votes",
			"database_id": "939e1258-6150-41ab-b4ba-f8cde43b0165"
		},
		{
			// Friends leaderboard (POST /lb/sync). Schema: migrations/0001_leaderboard.sql.
			"binding": "SCORES",
			"database_name": "ball-knowledge-scores",
			"database_id": "ba3fc787-1bb3-4f48-b032-56474bda2643"
		}
	],
	// Light abuse guard for POST /blind/vote.
	"ratelimits": [
		{
			"name": "VOTE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		},
		// POST /lb/sync, keyed by connection and by player id.
		{
			"name": "SCORES_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 }
		}
	]
}
